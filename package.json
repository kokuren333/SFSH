{
  "name": "sfsh",
  "version": "0.0.1",
  "private": true,
  "description": "SFSH (Super Fast Story Harness) — locally run harness that researches stories and publishes a static story-analysis site",
  "type": "module",
  "bin": {
    "sfsh": "harness/bin/sfsh.js"
  },
  "scripts": {
    "sfsh": "node harness/src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"harness/test/*.test.ts\"",
    "test:browser": "playwright test -c harness/test/browser"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "d3-force": "3.0.1",
    "d3-hierarchy": "3.1.3"
  }
}
