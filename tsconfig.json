{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["harness/src/**/*.ts", "harness/test/**/*.ts", "harness/probes/**/*.ts", "site/src/**/*.ts", "site/fixtures/**/*.ts"],
  "exclude": ["site/src/client/**"]
}
