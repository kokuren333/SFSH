# SFSH harness repository boundary (REQUIREMENTS §6.3-8 / WP-0.4)
# Public copy of the SFSH harness (allow-listed export by `sfsh harness-publish`). The working harness repository
# itself is local and has no remote; never add the Pages (site) repository as a remote there.

# Secrets / credentials
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Pages-side independent clone (separate repo; never nest it here)
/publish/
# Local test bare repository standing in for the Pages repo until the opening (M5, CP-041)
/publish-test/
# Work clone of the public harness repository (sfsh harness-publish; its own repo, origin = kokuren333/SFSH)
/harness-publish/
# Publish staging copy of dist + publish lock (M5)
/site/.publish-stage/
/site/.publish.lock/

# Build output (regenerable; only its copy goes to the Pages repo)
/site/dist/
/site/.input/
/site/.input.lock/

# Last-build A-2 report (regenerated by every build; evidence copies go under logs/m3/)
/logs/build/

# Dependencies
node_modules/

# Raw fetched pages (kept locally only; source cards + hashes are tracked)
/works/*/research/raw/

# OS / editor noise
Thumbs.db
.DS_Store

# AMENDMENT 09 regen backups (sfsh regen; local rollback copies of generated text)
works/*/gen/_backup-*/

# AMENDMENT 12 rework backups (sfsh job rework; local rollback copies of research/nkg/gen, includes raw pages)
works/*/_rework-backup-*/
