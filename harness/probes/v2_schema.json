{
  "type": "object",
  "additionalProperties": false,
  "required": ["phases", "claims"],
  "properties": {
    "phases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "enum": ["ph1", "ph2", "ph3"]},
          "label": {"type": "string", "maxLength": 20}
        }
      }
    },
    "claims": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "kind", "phase_ref", "epistemic"],
        "properties": {
          "id": {"type": "string", "pattern": "^c[0-9]{2}$"},
          "text": {"type": "string", "minLength": 4, "maxLength": 80},
          "kind": {"type": "string", "enum": ["event", "motive", "relation", "rule"]},
          "phase_ref": {"type": "string", "enum": ["ph1", "ph2", "ph3"]},
          "epistemic": {"type": "string", "enum": ["canon", "consensus", "fan_theory", "sfsh_analysis"]}
        }
      }
    }
  }
}
