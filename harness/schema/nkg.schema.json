{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sfsh.local/schema/nkg.schema.json",
  "title": "SFSH Narrative Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work",
    "sources",
    "nodes",
    "edges",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work": {
      "$ref": "#/definitions/work"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/edge"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/gap"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^ph[0-9]{1,2}$"
    },
    "holder": {
      "anyOf": [
        {
          "$ref": "#/definitions/id"
        },
        {
          "const": "audience"
        }
      ]
    },
    "module_id": {
      "enum": [
        "M01",
        "M02",
        "M03",
        "M04",
        "M05",
        "M06",
        "M07",
        "M08",
        "M09",
        "M10",
        "M11",
        "M12"
      ]
    },
    "node_module": {
      "enum": [
        "M01",
        "M02",
        "M03",
        "M04",
        "M05",
        "M06",
        "M07",
        "M08",
        "M09",
        "M10",
        "M11",
        "M12",
        "extra"
      ]
    },
    "epistemic": {
      "enum": [
        "canon",
        "consensus",
        "fan_theory",
        "sfsh_analysis"
      ]
    },
    "model_name": {
      "enum": [
        "haiku",
        "luna"
      ]
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ]
    },
    "provenance_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator",
        "support"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "direct",
            "inferred"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/provenance_item"
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "grade",
        "basis"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "confidence",
        "epistemic",
        "coverage_ref",
        "phase_ref",
        "spoiler",
        "authored_by",
        "reviewed_by",
        "review"
      ],
      "properties": {
        "provenance": {
          "$ref": "#/definitions/provenance"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "epistemic": {
          "$ref": "#/definitions/epistemic"
        },
        "coverage_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase_ref": {
          "anyOf": [
            {
              "$ref": "#/definitions/phase_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "spoiler": {
          "enum": [
            "none",
            "mid",
            "ending"
          ]
        },
        "authored_by": {
          "$ref": "#/definitions/model_name"
        },
        "reviewed_by": {
          "$ref": "#/definitions/model_name"
        },
        "review": {
          "enum": [
            "agreed",
            "revised",
            "disputed"
          ]
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "epistemic",
        "provenance"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "epistemic": {
          "enum": [
            "canon",
            "consensus",
            "fan_theory"
          ]
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "title",
        "publisher",
        "tier",
        "site_key",
        "license",
        "fetched_at"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/definitions/tier"
        },
        "site_key": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "fetched_at": {
          "type": "string"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/phase_id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "from",
        "to",
        "label"
      ],
      "properties": {
        "unit": {
          "enum": [
            "volume",
            "episode",
            "arc",
            "season",
            "whole"
          ]
        },
        "from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "type": [
            "integer",
            "null"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "module_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "weight",
        "enabled",
        "reason"
      ],
      "properties": {
        "module": {
          "$ref": "#/definitions/module_id"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "title_alt",
        "creators",
        "medium",
        "bibliographic",
        "genres",
        "coverage",
        "publish_mode",
        "rights",
        "module_selection",
        "phases"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "title_alt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "creators": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/creator"
          }
        },
        "medium": {
          "enum": [
            "novel",
            "manga",
            "anime",
            "film",
            "drama",
            "game",
            "other"
          ]
        },
        "bibliographic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "first_release",
            "status",
            "source_ids"
          ],
          "properties": {
            "publisher": {
              "type": [
                "string",
                "null"
              ]
            },
            "first_release": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "completed",
                "ongoing",
                "unknown"
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/coverage_unit"
          }
        },
        "publish_mode": {
          "enum": [
            "Public",
            "Restricted"
          ]
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "copyright_status",
            "holder_policy_note",
            "source_ids"
          ],
          "properties": {
            "state": {
              "type": "string"
            },
            "copyright_status": {
              "enum": [
                "in_copyright",
                "public_domain",
                "unknown"
              ]
            },
            "holder_policy_note": {
              "type": "string"
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "module_selection": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module_choice"
          }
        },
        "phases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "$ref": "#/definitions/phase"
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "what",
        "reason"
      ],
      "properties": {
        "module": {
          "$ref": "#/definitions/node_module"
        },
        "what": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "insufficient_sources",
            "conflicting_sources",
            "out_of_coverage"
          ]
        }
      }
    },
    "node_Character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "module",
        "label",
        "based_on",
        "meta"
      ],
      "properties": {
        "type": {
          "const": "Character"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "module": {
          "$ref": "#/definitions/node_module"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "analysis": {
          "type": "string"
        },
        "based_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "meta": {
          "$ref": "#/definitions/meta"
        }
      }
    },
    "node_Faction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "module",
        "label",
        "based_on",
        "meta"
      ],
      "properties": {
        "type": {
          "const": "Faction"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "module": {
          "$ref": "#/definitions/node_module"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "analysis": {
          "type": "string"
        },
        "based_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "meta": {
          "$ref": "#/definitions/meta"
        }
      }
    },
    "node_Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "module",
        "label",
        "based_on",
        "meta",
        "story_order",
        "disclosure_phase"
      ],
      "properties": {
        "type": {
          "const": "Event"
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "module": {
          "$ref": "#/definitions/node_module"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "analysis": {
          "type": "string"
        },
        "based_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "meta": {
          "$ref": "#/definitions/meta"
        },
        "story_order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "disclosure_phase": {
