        },
        "module": {
          "$ref": "#/definitions/node_module"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "analysis": {
          "type": "string"
        },
        "based_on": {
          "type": "array",
